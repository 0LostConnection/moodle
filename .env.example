# Copie para .env e preencha (Coolify: use Environment Variables da aplicação)
# cp .env.example .env

# --- Site (obrigatório) ---
# URL pública HTTPS (Cloudflare Tunnel / domínio). Sem barra no final.
MOODLE_URL=https://moodle.seudominio.com

# Porta no host (Coolify costuma mapear o serviço; local: 8080)
MOODLE_HOST_PORT=8080

# --- Admin (só na primeira instalação) ---
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=troque-esta-senha-forte
MOODLE_ADMIN_EMAIL=admin@seudominio.com
MOODLE_SITE_NAME=Moodle
MOODLE_SITE_SHORTNAME=moodle
MOODLE_LANG=pt_br
MOODLE_EXTRA_LANGS=en
MOODLE_TIMEZONE=America/Sao_Paulo

# --- Banco ---
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=troque-senha-db
MOODLE_DB_PREFIX=mdl_
MARIADB_ROOT_PASSWORD=troque-senha-root-db
# Ajuste conforme RAM do servidor (ex: 512M, 1G)
MARIADB_INNODB_BUFFER_POOL_SIZE=256M

# --- Redis (sessões + cache) ---
REDIS_PASSWORD=troque-senha-redis

# --- Proxy / Cloudflare ---
# auto: ativa sslproxy quando MOODLE_URL é https (recomendado com Tunnel)
MOODLE_SSL_PROXY=auto
MOODLE_REVERSE_PROXY=no

# --- PHP (opcional) ---
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_POST_MAX_SIZE=100M
PHP_MAX_EXECUTION_TIME=300

# --- Upgrade ---
MOODLE_AUTO_UPGRADE=on
